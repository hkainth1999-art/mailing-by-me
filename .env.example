# ==============================================================================
# 👑 Crown Mail Vault — Environment Configuration
# ==============================================================================

# Initial comma-separated list of inbound domains (You can also add/manage more domains inside Admin Dashboard)
DOMAINS=crwnmail.com,mail.crwnmail.com,rizzcord.site

# Web Dashboard and REST API Port (Default: 3000)
PORT=3000

# Inbound SMTP Server Port (Default: 25)
SMTP_PORT=25

# Data directory for SQLite persistent storage
DATA_DIR=./data

# ==============================================================================
# 🔒 Discord Authentication & Owner Access Control
# ==============================================================================
# 1. Comma-separated list of Discord User IDs that have Owner / Admin Panel access
# (Enable Developer Mode in Discord, right-click your profile -> "Copy User ID")
OWNER_IDS=123456789012345678,987654321098765432

# 2. Discord OAuth2 Application Credentials (From https://discord.com/developers/applications)
# Set redirect URI to: http://your-domain.com/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# 3. Server Cryptographic Secret for signing sessions and cookies (Auto-generated if left blank)
ADMIN_SECRET=
