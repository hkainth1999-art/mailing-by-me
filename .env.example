# ==============================================================================
# ⚡ Forsaken Mail (Modified) Environment Configuration
# ==============================================================================

# Comma-separated list of domains to accept emails for
DOMAINS=rizzcord.site,mail.rizzcord.site

# Web UI and REST API Port (Mapped to Port 80 by default in Docker)
PORT=3000

# Inbound SMTP Server Port (Listens on Port 25 for incoming emails)
SMTP_PORT=25

# Email Retention Period in Hours (automatically purges emails older than this)
RETENTION_HOURS=48

# Data directory for SQLite persistent storage
DATA_DIR=./data
