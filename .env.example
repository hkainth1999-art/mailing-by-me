# ==============================================================================
# 👑 Crown Mail Vault — Environment Configuration
# ==============================================================================

# Comma-separated list of inbound domains to accept emails for
DOMAINS=rizzcord.site,mail.rizzcord.site,crwnmail.com

# Web UI & REST API HTTP Port (Mapped to Port 80 in Docker)
PORT=3000

# Native HTTPS Port (Mapped to Port 443 in Docker if SSL certs provided)
HTTPS_PORT=3001

# Inbound SMTP Server Port (Listens on Port 25 for incoming emails)
SMTP_PORT=25

# Data directory for SQLite persistent storage
DATA_DIR=./data

# ==============================================================================
# 🔒 Discord Authentication & Owner Access Control
# ==============================================================================

# Your Discord User ID (automatically grants Owner / Admin Vault Access)
OWNER_IDS=1293104653650755604

# Discord Application Client ID (From https://discord.com/developers/applications)
DISCORD_CLIENT_ID=

# Discord Application Client Secret (From Discord Developer Portal -> OAuth2)
DISCORD_CLIENT_SECRET=

# Discord OAuth2 Redirect URI
# MUST be added to Discord Developer Portal -> OAuth2 -> Redirects:
# https://mail.rizzcord.site/api/auth/discord/callback
DISCORD_REDIRECT_URI=https://mail.rizzcord.site/api/auth/discord/callback

# ==============================================================================
# 🔒 HTTPS & SSL Configuration
# ==============================================================================

# Automatically redirect all incoming HTTP traffic to HTTPS (Set true when SSL is active)
FORCE_HTTPS=true

# Optional: Paths to SSL Certificate and Key (if using native HTTPS instead of Cloudflare)
# SSL_KEY_PATH=./data/certs/privkey.pem
# SSL_CERT_PATH=./data/certs/fullchain.pem
