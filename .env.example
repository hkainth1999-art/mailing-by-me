# ==============================================================================
# ⚡ CyberTemp Private Mail (Modified Forsaken Mail) Environment Config
# ==============================================================================

# Comma-separated list of domains to accept incoming emails for
DOMAINS=rizzcord.site,mail.rizzcord.site

# Web UI and REST API Port (Mapped to Port 80 by default in Docker)
PORT=3000

# Inbound SMTP Server Port (Listens on Port 25 for incoming emails)
SMTP_PORT=25

# Email Retention Period in Hours (240 hours = 10 Days conservation!)
RETENTION_HOURS=240

# Admin Portal Password for Generating API Keys
ADMIN_PASSWORD=cyberadmin2026

# Data directory for SQLite persistent storage
DATA_DIR=./data
